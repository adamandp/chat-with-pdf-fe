# Vercel/demo: the service worker handles the complete NestJS-style contract.
NEXT_PUBLIC_API_MOCKING=enabled
NEXT_PUBLIC_API_URL=/api

# Local integration: run Next on localhost:3001 and NestJS on localhost:3000.
# The NestJS app has no /api global prefix.
# NEXT_PUBLIC_API_MOCKING=disabled
# NEXT_PUBLIC_API_URL=http://localhost:3000
